# ProofMesh Environment Configuration Template
# Copy to .env for local development: cp .env.example .env

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://proofmesh:proofmesh_dev_password@localhost:5432/proofmesh_dev

# Test Database Configuration
TEST_DATABASE_URL=postgresql://proofmesh_test:proofmesh_test_password@localhost:5433/proofmesh_test

# Authentication & Security
# WARNING: Change in production environments!
JWT_SECRET=development_jwt_secret_min_16_characters_long

# Policy Enforcement Failure Mode (fail_open | fail_closed)
FAIL_POLICY=fail_closed

# Logging (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info
